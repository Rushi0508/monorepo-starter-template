// ─────────────────────────────────────────────────────────────────────────────
// Demand Planning
// ─────────────────────────────────────────────────────────────────────────────

enum DemandPlanKind {
  BASE
  SCENARIO
}

enum DemandPlanStatus {
  DRAFT
  /// Scenarios are saved rather than finalized
  SAVED
  FINAL
}

model DemandPlan {
  id String @id @default(uuid()) @db.Uuid

  /// Given when the plan is created; plans are never auto-created, so this is
  /// always set.
  name   String
  kind   DemandPlanKind   @default(BASE)
  status DemandPlanStatus @default(DRAFT)

  /// "YYYY-MM" — the plan's anchor: the first forecast month, and the line
  /// between settled actuals and forecast. Fixed at creation, since moving it
  /// would reclassify months underneath everything already typed.
  planMonth  String
  /// "YYYY-MM" — inclusive last forecast month. Editable from the config sheet
  /// while the plan is a draft; extending costs nothing because cells are
  /// computed, and shrinking leaves out-of-window entries dormant rather than
  /// deleting them.
  horizonEnd String

  /// Scenarios point back at the base plan they were forked from
  basePlanId String? @db.Uuid

  notes String @default("")

  // ── Variables ──────────────────────────────────────────────────────────────
  // Configured while the plan is a draft and frozen once it is finalized, so a
  // finalized plan reproduces with the settings it was signed off under.

  /// "Flag an override above" — an override this far from the statistical
  /// forecast is marked with a warning in the grid. Flagged, not forbidden.
  flagOverrideAbovePct Float @default(0.15)

  /// "Require reason above" — above this, editing a cell demands a reason and
  /// lets you attach a note before it is accepted.
  requireReasonAbovePct Float @default(0.25)

  createdById   String?   @db.Uuid
  savedAt       DateTime?
  savedById     String?   @db.Uuid
  finalizedAt   DateTime?
  finalizedById String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  channelScopes           DemandPlanChannelScope[]
  methods                 DemandForecastMethod[]
  cogs                    DemandPlanCogs[]
  channelFulfillmentCosts DemandPlanChannelFulfillmentCost[]
  channelPrices           DemandPlanChannelPrice[]
  entries                 DemandPlanEntry[]
  baselineActuals         DemandPlanBaselineActual[]
  audits                  DemandPlanAudit[]

  createdBy   User? @relation("DemandPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  savedBy     User? @relation("DemandPlanSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  finalizedBy User? @relation("DemandPlanFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  @@index([kind, status])
  @@index([planMonth])
  @@index([basePlanId])
  @@map("demand_plans")
}

/// Which SKUs a plan forecasts in one channel.
///
/// A channel sells its own set of SKUs, so scope is per channel rather than a
/// plan-wide SKU list crossed with a plan-wide channel list.
model DemandPlanChannelScope {
  id      String @id @default(uuid()) @db.Uuid
  planId  String @db.Uuid
  channel String

  /// A plain array, as the plan's scope was before it moved here: a finalized
  /// plan keeps the SKUs it was signed off with even if one is later deleted
  /// from settings.
  skuSettingIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  plan DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, channel])
  @@index([planId])
  @@map("demand_plan_channel_scopes")
}

enum ForecastMethodType {
  /// Compounds off the last known actual, month over month
  STATIC_GROWTH
  /// Averages the trailing window of actuals and holds that level flat
  HISTORICAL_AVERAGE
  /// Values are typed, pasted or imported; no statistical baseline
  HARD_ENTRY
}

/// How the statistical baseline is produced for one channel x SKU series. A row
/// exists only where a planner chose something other than the default, so a
/// fresh plan starts empty. Forking a scenario copies these rows.
model DemandForecastMethod {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  channel      String
  skuSettingId String @db.Uuid

  method ForecastMethodType

  /// STATIC_GROWTH only
  growthPct    Float?
  /// HISTORICAL_AVERAGE only
  windowMonths Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)

  @@unique([planId, channel, skuSettingId])
  @@index([planId])
  @@map("demand_forecast_methods")
}

/// A plan's own copy of the SKU's COGS ladder, taken when the plan is created,
/// so a later SKU settings edit cannot move the plan's costs. Mirrors SkuCogs
/// field for field.
model DemandPlanCogs {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  skuSettingId String @db.Uuid

  materials  Float @default(0)
  production Float @default(0)
  shipping   Float @default(0)

  /// Always materials + production + shipping, as on SkuCogs.
  amount        Float
  effectiveFrom DateTime
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)

  @@unique([planId, skuSettingId, effectiveFrom])
  @@index([planId, skuSettingId, effectiveFrom(sort: Desc)])
  @@map("demand_plan_cogs")
}

/// A plan's copy of a channel's fulfillment cost ladder. Same rule as
/// DemandPlanCogs.
model DemandPlanChannelFulfillmentCost {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  skuSettingId String @db.Uuid
  channel      String

  storage  Float @default(0)
  pick     Float @default(0)
  pack     Float @default(0)
  shipping Float @default(0)

  /// Always storage + pick + pack + shipping, as on SkuChannelFulfillmentCost.
  amount        Float
  effectiveFrom DateTime
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)

  @@unique([planId, skuSettingId, channel, effectiveFrom])
  @@index([planId, skuSettingId, channel, effectiveFrom(sort: Desc)])
  @@map("demand_plan_channel_fulfillment_costs")
}

/// A plan's copy of a channel's price ladder. Same rule as DemandPlanCogs.
model DemandPlanChannelPrice {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  skuSettingId String @db.Uuid
  channel      String

  amount        Float
  effectiveFrom DateTime
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)

  @@unique([planId, skuSettingId, channel, effectiveFrom])
  @@index([planId, skuSettingId, channel, effectiveFrom(sort: Desc)])
  @@map("demand_plan_channel_prices")
}

enum DemandOverrideReason {
  PROMOTION
  CUSTOMER_COMMITMENT
  SALES_INPUT
  MARKETING_CAMPAIGN
  INVENTORY_CONSTRAINT
  NEW_CUSTOMER
  MARKET_TREND
  MANUAL_ADJUSTMENT
  OTHER
}

/// The only cell values ever stored. A row exists where a planner typed a
/// number — either overriding the statistical forecast, or supplying a value
/// for a HARD_ENTRY series. Everything else in the grid is computed, so
/// changing the horizon costs nothing.
///
/// Deleting a row is what "revert to statistical" does.
model DemandPlanEntry {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  channel      String
  skuSettingId String @db.Uuid

  /// "YYYY-MM"
  period String
  units  Int

  /// Required by the service once the change exceeds the plan's
  /// requireReasonAbovePct; absent on a hard entry, which has no baseline to
  /// deviate from.
  reason DemandOverrideReason?
  note   String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("DemandPlanEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([planId, channel, skuSettingId, period])
  @@index([planId, period])
  @@map("demand_plan_entries")
}

/// Monthly units and net revenue rolled up from Shopify orders — every channel
/// is derived from an order's appName and tags, so Shopify is the only sales
/// source. BlueBox is fulfillment and SimplyDepo is a catalogue.
/// The input to every statistical method, and the truth accuracy is scored
/// against. A cache refreshed by a job, not a source of record — Prisma cannot
/// model a Postgres materialized view, so this is a plain table.
model DemandActual {
  id           String @id @default(uuid()) @db.Uuid
  channel      String
  skuSettingId String @db.Uuid

  /// "YYYY-MM"
  period String
  units  Int    @default(0)

  /// Before discounts and refunds — what a forecast can be compared against,
  /// since neither can be predicted for a future month.
  grossRevenue Float @default(0)
  /// Gross less discounts and refunds. What the Revenue page reports.
  netRevenue   Float @default(0)

  /// True while the month is still in progress, so a half-finished period is
  /// never averaged in as though it were closed.
  isPartial   Boolean  @default(false)
  refreshedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Cascade)

  @@unique([channel, skuSettingId, period])
  @@index([skuSettingId, period])
  @@index([period])
  @@map("demand_actuals")
}

/// The actuals a finalized plan was computed from, copied once at finalize and
/// never touched again. Without this a late refund landing next month would
/// silently rewrite what the plan "forecast", and Forecast Accuracy would be
/// scoring against a moving target.
///
/// Holds history up to the plan month, not the forecast horizon — which is why
/// a finalized plan can still be viewed over any horizon.
model DemandPlanBaselineActual {
  id           String @id @default(uuid()) @db.Uuid
  planId       String @db.Uuid
  channel      String
  skuSettingId String @db.Uuid

  /// "YYYY-MM"
  period String
  units  Int    @default(0)

  grossRevenue Float @default(0)
  netRevenue   Float @default(0)

  createdAt DateTime @default(now())

  /// Relations
  plan       DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Restrict)

  @@unique([planId, channel, skuSettingId, period])
  @@index([planId, period])
  @@map("demand_plan_baseline_actuals")
}

/// Activity feed for one plan. A plain string activity plus metadata, matching
/// SkuSettingsAuditLog — the prototype's action enum reached sixteen values
/// before anything shipped, and a string absorbs the next ten without a
/// migration.
model DemandPlanAudit {
  id       String @id @default(uuid()) @db.Uuid
  planId   String @db.Uuid
  activity String

  userId String? @db.Uuid

  createdAt DateTime @default(now())

  /// Relations
  plan DemandPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt(sort: Desc)])
  @@map("demand_plan_audits")
}

enum FolkMappingStatus {
  PENDING_REVIEW
  MAPPED
  UNMAPPED
}

/// Folk groups Sauero tracks. Companies in these groups are seeded into the
/// mapping table; untracked groups are ignored entirely.
model FolkTrackedGroup {
  id          String   @id @default(uuid()) @db.Uuid
  folkGroupId String   @unique
  /// Mirrored from Folk on every seed, so a rename in Folk follows through.
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("folk_tracked_groups")
}

model FolkCompanyMapping {
  id                 String            @id @default(uuid()) @db.Uuid
  folkCompanyId      String            @unique
  folkGroupId        String
  sdCustomerId       String?
  folkCompanyName    String
  folkEmail          String?
  status             FolkMappingStatus @default(UNMAPPED)
  matchScore         Float?
  proposedCustomerId String?           @db.Uuid
  /// A denied proposal; the seed won't propose this customer again.
  rejectedCustomerId String?           @db.Uuid
  pipelineStatus     String?
  customerType       String?
  lastContactAt      DateTime?
  lastContactType    String?
  /// Set once the nightly Folk reconcile has created or found the
  /// Shopify customer for this company; the pipeline skips it after that.
  shopifyPushedAt    DateTime?
  /// Why the last push attempt did not go through, e.g. no email in Folk.
  shopifyPushError   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  customers        ShopifyCustomer[] @relation("FolkMappedCustomers")
  proposedCustomer ShopifyCustomer?  @relation("FolkProposedCustomer", fields: [proposedCustomerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([proposedCustomerId])
  @@map("folk_company_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Help Center
// ─────────────────────────────────────────────────────────────────────────────

model TrainingVideo {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?
  /// The Loom or Tella link as pasted; the embed URL is derived from it.
  url         String

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("training_videos")
}
