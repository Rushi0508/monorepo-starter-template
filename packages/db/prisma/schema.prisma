generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  sessions             Session[]
  accounts             Account[]
  skuSettingsAuditLogs SkuSettingsAuditLog[]
  oauthApplications    oauthApplication[]
  oauthAccessTokens    oauthAccessToken[]
  oauthConsents        oauthConsent[]

  demandPlansCreated   DemandPlan[]      @relation("DemandPlanCreatedBy")
  demandPlansSaved     DemandPlan[]      @relation("DemandPlanSavedBy")
  demandPlansFinalized DemandPlan[]      @relation("DemandPlanFinalizedBy")
  demandPlanEntries    DemandPlanEntry[] @relation("DemandPlanEntryCreatedBy")
  demandPlanAudits     DemandPlanAudit[]
  trainingVideos       TrainingVideo[]

  @@unique([email])
  @@map("users")
}

model oauthApplication {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  icon         String?
  metadata     String?
  clientId     String
  clientSecret String?
  redirectUrls String
  type         String
  disabled     Boolean? @default(false)
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessTokens oauthAccessToken[]
  consents     oauthConsent[]

  @@unique([clientId])
  @@index([userId])
}

model oauthAccessToken {
  id                    String           @id @default(uuid()) @db.Uuid
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  client                oauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?          @db.Uuid
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([accessToken])
  @@unique([refreshToken])
  @@index([clientId])
  @@index([userId])
}

model oauthConsent {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String
  client       oauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shopify Models
// ─────────────────────────────────────────────────────────────────────────────

model ShopifyCustomer {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String

  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  displayName String?
  state       String?
  note        String?
  tags        String[]
  saueroCode  String?  @unique
  storeCount  Int      @default(1)

  shopifyCreatedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  folkCompanyMappingId String?   @db.Uuid

  /// Relations
  addresses          ShopifyCustomerAddress[]
  orders             ShopifyOrder[]
  subscriptions      ShopifySubscription[]
  folkCompanyMapping FolkCompanyMapping?      @relation("FolkMappedCustomers", fields: [folkCompanyMappingId], references: [id], onDelete: SetNull)
  folkProposedFor    FolkCompanyMapping[]     @relation("FolkProposedCustomer")

  @@unique([shopifyId])
  @@index([folkCompanyMappingId])
  @@map("shopify_customers")
}

model ShopifyCustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  shopifyId  String
  customerId String @db.Uuid

  firstName    String?
  lastName     String?
  company      String?
  address1     String?
  address2     String?
  city         String?
  province     String?
  country      String?
  zip          String?
  phone        String?
  name         String?
  provinceCode String?
  countryCode  String?
  isDefault    Boolean @default(false)

  /// Relations
  customer ShopifyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopifyId])
  @@index([customerId])
  @@map("shopify_customer_addresses")
}

model ShopifyProduct {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String

  title       String?
  vendor      String?
  productType String?
  status      String?
  tags        String[]

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Relations
  variants ShopifyProductVariant[]

  @@unique([shopifyId])
  @@map("shopify_products")
}

model ShopifyProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String
  productId String @db.Uuid

  barcode           String?
  price             Float?
  sku               String?
  title             String?
  inventoryQuantity Int?

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Relations
  product ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopifyId])
  @@index([productId])
  @@map("shopify_product_variants")
}

model ShopifyOrder {
  id         String  @id @default(uuid()) @db.Uuid
  shopifyId  String
  customerId String? @db.Uuid

  orderNumber         Int
  orderName           String?
  financialStatus     String?
  fulfillmentStatus   String?
  email               String?
  phone               String?
  note                String?
  noteAttributes      Json?
  tags                String[]
  sourceName          String?
  appName             String?
  subtotalPrice       Float?
  totalDiscounts      Float?
  totalShippingPrice  Float?
  totalTax            Float?
  totalPrice          Float?
  currency            String?
  paymentTerms        String?
  paymentGatewayNames String[]

  /// Shipping address
  shipName         String?
  shipCompany      String?
  shipAddress1     String?
  shipAddress2     String?
  shipCity         String?
  shipProvinceCode String?
  shipZip          String?
  shipCountryCode  String?
  shipPhone        String?

  // Billing address
  billName         String?
  billCompany      String?
  billAddress1     String?
  billAddress2     String?
  billCity         String?
  billProvinceCode String?
  billZip          String?
  billCountryCode  String?
  billPhone        String?

  cancelledAt  DateTime?
  cancelReason String?

  closed   Boolean   @default(false)
  closedAt DateTime?

  processedAt DateTime?

  // Custom fields
  isBundleOrder       Boolean @default(false)
  isSubscriptionOrder Boolean @default(false)

  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Relations
  customer     ShopifyCustomer?       @relation(fields: [customerId], references: [id])
  lineItems    ShopifyOrderLineItem[]
  refunds      ShopifyRefund[]
  fulfillments ShopifyFulfillment[]
  emailFlow    OrderEmailFlow?

  @@unique([shopifyId])
  @@index([customerId])
  @@index([sourceName])
  @@map("shopify_orders")
}

model ShopifyOrderLineItem {
  id        String  @id @default(uuid()) @db.Uuid
  shopifyId String
  orderId   String  @db.Uuid
  productId String? @db.Uuid
  variantId String? @db.Uuid

  sku          String?
  title        String?
  variantTitle String?
  vendor       String?

  quantity            Int
  currentQuantity     Int?
  price               Float?
  totalDiscount       Float?
  discountAllocations Json?

  fulfillmentStatus String?
  requiresShipping  Boolean?
  taxable           Boolean?
  giftCard          Boolean?

  /// Relations
  order                ShopifyOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundLineItems      ShopifyRefundLineItem[]
  fulfillmentLineItems ShopifyFulfillmentLineItem[]

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopifyId])
  @@index([orderId])
  @@map("shopify_order_line_items")
}

model ShopifyRefund {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String
  orderId   String @db.Uuid

  note        String?
  processedAt DateTime?

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Relations
  order        ShopifyOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineItems    ShopifyRefundLineItem[]
  transactions ShopifyRefundTransaction[]

  @@unique([shopifyId])
  @@index([orderId])
  @@map("shopify_refunds")
}

model ShopifyRefundLineItem {
  id         String @id @default(uuid()) @db.Uuid
  shopifyId  String
  refundId   String @db.Uuid
  lineItemId String @db.Uuid

  quantity Int
  subtotal Float?
  totalTax Float?

  /// Relations
  refund   ShopifyRefund        @relation(fields: [refundId], references: [id], onDelete: Cascade)
  lineItem ShopifyOrderLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopifyId])
  @@index([refundId])
  @@index([lineItemId])
  @@map("shopify_refund_line_items")
}

model ShopifyRefundTransaction {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String
  refundId  String @db.Uuid

  amount   Float?
  currency String?
  gateway  String?
  status   String?
  kind     String?

  /// Relations
  refund ShopifyRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopifyId])
  @@index([refundId])
  @@map("shopify_refund_transactions")
}

model ShopifyFulfillment {
  id        String @id @default(uuid()) @db.Uuid
  shopifyId String
  orderId   String @db.Uuid

  status              String?
  shipmentStatus      String?
  trackingCompany     String?
  trackingNumber      String?
  trackingNumbers     String[]
  trackingUrl         String?
  trackingUrls        String[]
  deliveredAt         DateTime?
  inTransitAt         DateTime?
  estimatedDeliveryAt DateTime?

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Relations
  order ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  lineItems ShopifyFulfillmentLineItem[]

  @@unique([shopifyId])
  @@index([orderId])
  @@map("shopify_fulfillments")
}

model ShopifyFulfillmentLineItem {
  id            String @id @default(uuid()) @db.Uuid
  shopifyId     String
  fulfillmentId String @db.Uuid
  lineItemId    String @db.Uuid

  quantity Int

  /// Relations
  fulfillment ShopifyFulfillment   @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  lineItem    ShopifyOrderLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopifyId])
  @@index([fulfillmentId])
  @@index([lineItemId])
  @@map("shopify_fulfillment_line_items")
}

model ShopifySubscription {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String
  status          String
  customerId      String    @db.Uuid
  nextBillingDate DateTime?

  /// Relations
  customer ShopifyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId])
  @@index([customerId])
  @@map("shopify_subscriptions")
}

model ShopifySessionsDaily {
  id                 String   @id @default(uuid()) @db.Uuid
  date               DateTime
  sessions           Int
  completedCheckouts Int
  conversionRate     Float?

  @@unique([date])
  @@map("shopify_sessions_daily")
}

model ShopifySessionsChannelDeviceDaily {
  id                 String   @id @default(uuid()) @db.Uuid
  date               DateTime
  referringChannel   String
  deviceType         String
  sessions           Int
  completedCheckouts Int

  @@unique([date, referringChannel, deviceType])
  @@map("shopify_sessions_channel_device_daily")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shopify Inventory (source of truth for multi-location stock)
// ─────────────────────────────────────────────────────────────────────────────

model ShopifyLocation {
  id        String  @id @default(uuid()) @db.Uuid
  shopifyId String  @unique
  name      String
  address1  String?
  address2  String?
  city      String?
  province  String?
  country   String?
  zip       String?
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLevels ShopifyInventoryLevel[]

  @@map("shopify_locations")
}

model ShopifyInventoryItem {
  id        String  @id @default(uuid()) @db.Uuid
  shopifyId String  @unique
  sku       String?
  tracked   Boolean @default(true)

  unitCostAmount   Float?
  unitCostCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLevels ShopifyInventoryLevel[]

  @@index([sku])
  @@map("shopify_inventory_items")
}

model ShopifyInventoryLevel {
  id              String @id @default(uuid()) @db.Uuid
  inventoryItemId String @db.Uuid
  locationId      String @db.Uuid

  available      Int @default(0)
  onHand         Int @default(0)
  committed      Int @default(0)
  incoming       Int @default(0)
  reserved       Int @default(0)
  damaged        Int @default(0)
  safetyStock    Int @default(0)
  qualityControl Int @default(0)

  shopifyUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventoryItem ShopifyInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location      ShopifyLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, locationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@map("shopify_inventory_levels")
}

// ─────────────────────────────────────────────────────────────────────────────
// BlueBox Models
// ─────────────────────────────────────────────────────────────────────────────

model BlueboxInventory {
  id            String  @id @default(uuid()) @db.Uuid
  sku           String
  description   String?
  warehouseCode String  @default("")
  rop           Int?
  onHand        Int?
  committed     Int?
  available     Int?
  backordered   Int?
  quarantined   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, warehouseCode])
  @@index([sku])
  @@map("bluebox_inventory")
}

model BlueboxInventoryByLot {
  id String @id @default(uuid()) @db.Uuid

  sku                 String
  shortDescription    String?
  qty                 Int?
  lotNumber           String    @default("")
  expirationDate      DateTime?
  physicalWarehouseId Int?
  warehouseCode       String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, lotNumber, warehouseCode])
  @@index([sku])
  @@index([lotNumber])
  @@map("bluebox_inventory_by_lot")
}

model BlueboxAsn {
  id String @id @default(uuid()) @db.Uuid

  blueboxId          Int
  customerNumber     String?
  status             String?
  description        String?
  longDescription    String?
  expectedDate       DateTime?
  actualArriveDate   DateTime?
  completeDate       DateTime?
  countedDate        DateTime?
  isExpedited        Boolean   @default(false)
  memo               String?
  notes              String?
  trackingNumber     String?
  shipper            String?
  warehouseCode      String?
  externalId         String?
  externalSource     String?
  cartonCount        Int?
  palletCount        Int?
  additionalHandling String?

  shipToCompanyName String?
  shipToFirstName   String?
  shipToLastName    String?
  shipToAddress1    String?
  shipToAddress2    String?
  shipToCity        String?
  shipToState       String?
  shipToZip         String?
  shipToCountry     String?
  shipToPhone       String?
  shipToEmail       String?

  shipFromCompanyName String?
  shipFromFirstName   String?
  shipFromLastName    String?
  shipFromAddress1    String?
  shipFromAddress2    String?
  shipFromCity        String?
  shipFromState       String?
  shipFromZip         String?
  shipFromCountry     String?
  shipFromPhone       String?
  shipFromEmail       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  items BlueboxAsnItem[]

  @@unique([blueboxId])
  @@index([status])
  @@index([externalId])
  @@map("bluebox_asns")
}

model BlueboxAsnItem {
  id    String @id @default(uuid()) @db.Uuid
  asnId String @db.Uuid

  blueboxId        Int?
  skuId            Int?
  sku              String
  upc              String?
  description      String?
  quantitySent     Int?
  quantityDamaged  Int?
  quantityReceived Int?
  quantityShelved  Int?
  expiration       DateTime?
  cost             Float?
  carton           String?
  notes            String?
  lot              String?
  externalId       String?
  poNumber         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  asn BlueboxAsn @relation(fields: [asnId], references: [id], onDelete: Cascade)

  @@index([asnId])
  @@index([sku])
  @@map("bluebox_asn_items")
}

model BlueboxKitOrder {
  id String @id @default(uuid()) @db.Uuid

  blueboxId                 Int
  kitConfigId               Int?
  kitDescription            String?
  versionNumber             Int?
  billableCost              Float?
  workflowStep              String?
  workflowStatus            String?
  priority                  Int?
  laneName                  String?
  physicalWarehouseId       Int?
  physicalWarehouseName     String?
  quantity                  Int
  quantityBuilt             Int
  percentComplete           Float?
  rawVirtualWarehouseName   String?
  finalVirtualWarehouseName String?
  fulfillmentOrderIds       Int[]
  createdDate               DateTime?
  requestedDate             DateTime?
  completedDate             DateTime?
  canceledDate              DateTime?
  inventoryReserveDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  finalItems BlueboxKitOrderFinalItem[]
  rawItems   BlueboxKitOrderRawItem[]

  @@unique([blueboxId])
  @@map("bluebox_kit_orders")
}

model BlueboxKitOrderFinalItem {
  id         String @id @default(uuid()) @db.Uuid
  kitOrderId String @db.Uuid

  sku           String
  upc           String?
  description   String?
  quantity      Int
  quantityBuilt Int

  /// Relations
  kitOrder BlueboxKitOrder @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)

  @@index([kitOrderId])
  @@index([sku])
  @@map("bluebox_kit_order_final_items")
}

model BlueboxKitOrderRawItem {
  id         String @id @default(uuid()) @db.Uuid
  kitOrderId String @db.Uuid

  sku                    String
  upc                    String?
  description            String?
  quantity               Int
  quantityReserved       Int
  quantityConsumed       Int
  requiredLotNumber      String?
  requiredExpirationDate DateTime?
  consumeMethod          String?

  /// Relations
  kitOrder BlueboxKitOrder @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)

  @@index([kitOrderId])
  @@index([sku])
  @@map("bluebox_kit_order_raw_items")
}

model BlueboxOrder {
  id String @id @default(uuid()) @db.Uuid

  blueboxId           Int
  orderNumber         String?
  customerOrderNumber String?
  customerNumber      String?
  externalId          String?
  externalSource      String?
  orderSource         String?
  status              String?
  workflowStatus      String?
  deliveryStatus      String?

  trackingNumber    String?
  masterTracking    String?
  shippingCompany   String?
  shippingService   String?
  shippingCost      Float?
  physicalWarehouse String?

  paymentStatus String?
  paymentMethod String?
  paidAmount    Float?

  discountAmount Float?
  taxAmount      Float?

  memo        String?
  poNumber    String?
  isCanceled  Boolean @default(false)
  isRushOrder Boolean @default(false)

  dateOrderReceived  DateTime?
  dateOrderShipped   DateTime?
  dateOrderDelivered DateTime?
  dateOrderPicked    DateTime?
  dateOrderPacked    DateTime?
  createDateTime     DateTime?

  shipToCompanyName String?
  shipToFirstName   String?
  shipToLastName    String?
  shipToAddress1    String?
  shipToAddress2    String?
  shipToCity        String?
  shipToState       String?
  shipToZip         String?
  shipToCountry     String?
  shipToPhone       String?
  shipToEmail       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  checkpoints BlueboxOrderCheckpoint[]
  items       BlueboxOrderItem[]

  @@unique([blueboxId])
  @@index([externalId])
  @@index([orderNumber])
  @@index([status])
  @@index([workflowStatus])
  @@map("bluebox_orders")
}

model BlueboxOrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  blueboxId         Int?
  sku               String?
  quantity          Int?
  upc               String?
  quantityCancelled Int?
  price             Float?
  discountAmount    Float?
  notes             String?
  weight            Float?
  description       String?
  lot               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  order BlueboxOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("bluebox_order_items")
}

model BlueboxOrderCheckpoint {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  checkpointTime DateTime?
  slug           String?
  location       String?
  city           String?
  state          String?
  countryRegion  String?
  zip            String?
  tag            String?
  message        String?
  carrier        String?

  createdAt DateTime @default(now())

  /// Relations
  order BlueboxOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tag])
  @@map("bluebox_order_checkpoints")
}

model BlueboxOutboundShipment {
  id String @id @default(uuid()) @db.Uuid

  shipmentId     String
  created        DateTime?
  readyForLabels Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  orders BlueboxOutboundShipmentOrder[]

  @@unique([shipmentId])
  @@map("bluebox_outbound_shipments")
}

model BlueboxOutboundShipmentOrder {
  id         String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid

  blueboxOrderId      Int?
  orderNumber         String?
  customerOrderNumber String?
  externalId          String?
  externalSource      String?
  status              String?
  trackingNumber      String?
  shippingCompany     String?
  shippingService     String?
  shippingCost        Float?
  dateOrderShipped    DateTime?
  dateOrderDelivered  DateTime?
  dateOrderReceived   DateTime?

  shipToFirstName String?
  shipToLastName  String?
  shipToAddress1  String?
  shipToAddress2  String?
  shipToCity      String?
  shipToState     String?
  shipToZip       String?
  shipToCountry   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  shipment BlueboxOutboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
