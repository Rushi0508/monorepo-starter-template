/// A code a SKU used to go by. Shopify, BlueBox and SimplyDepo keep the code an
/// order was placed under forever, so a renamed SKU must still resolve its old
/// codes. Unique across settings and aliases, compared case-insensitively.
model SkuAlias {
  id           String   @id @default(uuid()) @db.Uuid
  skuSettingId String   @db.Uuid
  sku          String   @unique
  createdAt    DateTime @default(now())

  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Cascade)

  @@index([skuSettingId])
  @@map("sku_aliases")
}

/// Cost of goods for one unit of a SKU — the same in every channel. Landed
/// cost is not stored: it is this plus the fulfillment cost of the channel.
model SkuCogs {
  id           String @id @default(uuid()) @db.Uuid
  skuSettingId String @db.Uuid

  materials  Float @default(0)
  production Float @default(0)
  /// Inbound: getting the product to the warehouse.
  shipping   Float @default(0)

  /// Always materials + production + shipping. Stored so readers of a past
  /// version get the total without re-adding it.
  amount        Float
  effectiveFrom DateTime
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Cascade)

  @@unique([skuSettingId, effectiveFrom])
  @@index([skuSettingId, effectiveFrom(sort: Desc)])
  @@map("sku_cogs")
}

/// Cost to fulfill one unit of a SKU through a channel.
model SkuChannelFulfillmentCost {
  id           String @id @default(uuid()) @db.Uuid
  skuSettingId String @db.Uuid
  channel      String

  storage  Float @default(0)
  pick     Float @default(0)
  pack     Float @default(0)
  /// Outbound: getting the order to the customer. For BlueBox orders, BlueBox's
  /// actual shipping cost replaces this part.
  shipping Float @default(0)

  /// Always storage + pick + pack + shipping.
  amount        Float
  effectiveFrom DateTime
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  skuSetting SkuSetting @relation(fields: [skuSettingId], references: [id], onDelete: Cascade)

  @@unique([skuSettingId, channel, effectiveFrom])
  @@index([skuSettingId, channel, effectiveFrom(sort: Desc)])
