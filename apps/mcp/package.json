{
	"name": "mcp",
	"version": "0.1.0",
	"description": "Sauero MCP server — exposes read-only Sauero data as MCP tools",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.17.0",
		"npm": "only-allow pnpm",
		"yarn": "only-allow pnpm"
	},
	"bin": {
		"sauero-mcp": "./dist/index.js"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc",
		"dev": "heizen-secrets run -- tsx watch src/index.ts",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.3",
		"@repo/constants": "workspace:*",
		"@repo/docs": "workspace:*",
		"@repo/enums": "workspace:*",
		"@repo/types": "workspace:*",
		"axios": "^1.20.0",
		"dotenv": "^17.4.2",
		"express": "^5.1.0",
		"zod": "^3.25.56"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.7",
		"tsx": "^4.19.2"
	}
}
