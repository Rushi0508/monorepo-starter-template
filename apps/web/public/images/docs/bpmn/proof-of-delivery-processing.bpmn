      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok" isMarkerVisible="true"><dc:Bounds x="1295" y="405" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1270" y="369" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_f1_di" bpmnElement="end_f1"><dc:Bounds x="1302" y="557" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1344" y="560" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="link_di" bpmnElement="link"><dc:Bounds x="1420" y="392" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="find_di" bpmnElement="find"><dc:Bounds x="1580" y="392" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_found_di" bpmnElement="gw_found" isMarkerVisible="true"><dc:Bounds x="1775" y="405" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1750" y="369" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_f2_di" bpmnElement="end_f2"><dc:Bounds x="1782" y="557" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1824" y="560" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_done_di" bpmnElement="gw_done" isMarkerVisible="true"><dc:Bounds x="1935" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="skip_di" bpmnElement="skip"><dc:Bounds x="2060" y="252" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="match_di" bpmnElement="match"><dc:Bounds x="2060" y="392" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_left_di" bpmnElement="gw_left" isMarkerVisible="true"><dc:Bounds x="2255" y="405" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2230" y="369" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_f3_di" bpmnElement="end_f3"><dc:Bounds x="2262" y="557" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2304" y="560" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="record_di" bpmnElement="record"><dc:Bounds x="2380" y="392" width="120" height="76" /></bpmndi:BPMNShape>
