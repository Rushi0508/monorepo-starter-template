      <bpmndi:BPMNShape id="gw_mb_di" bpmnElement="gw_mb" isMarkerVisible="true"><dc:Bounds x="495" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_mb_di" bpmnElement="end_mb"><dc:Bounds x="502" y="272" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="544" y="275" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_pod_di" bpmnElement="gw_pod" isMarkerVisible="true"><dc:Bounds x="655" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ign_di" bpmnElement="end_ign"><dc:Bounds x="662" y="272" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="704" y="275" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="store_di" bpmnElement="store"><dc:Bounds x="780" y="392" width="120" height="76" /></bpmndi:BPMNShape>
