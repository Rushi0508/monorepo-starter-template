      <bpmndi:BPMNShape id="gw_more_di" bpmnElement="gw_more" isMarkerVisible="true"><dc:Bounds x="2735" y="405" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2710" y="369" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="2902" y="412" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_0_di" bpmnElement="SF_0"><di:waypoint x="218" y="115" /><di:waypoint x="300" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1"><di:waypoint x="420" y="115" /><di:waypoint x="502" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2"><di:waypoint x="378" y="430" /><di:waypoint x="495" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_3_di" bpmnElement="SF_3"><di:waypoint x="520" y="405" /><di:waypoint x="520" y="308" /><bpmndi:BPMNLabel><dc:Bounds x="526" y="348" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_4_di" bpmnElement="SF_4"><di:waypoint x="545" y="430" /><di:waypoint x="655" y="430" /><bpmndi:BPMNLabel><dc:Bounds x="580" y="408" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5"><di:waypoint x="680" y="405" /><di:waypoint x="680" y="308" /><bpmndi:BPMNLabel><dc:Bounds x="686" y="348" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6"><di:waypoint x="705" y="430" /><di:waypoint x="780" y="430" /><bpmndi:BPMNLabel><dc:Bounds x="722" y="408" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_7_di" bpmnElement="SF_7"><di:waypoint x="900" y="430" /><di:waypoint x="940" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_8_di" bpmnElement="SF_8"><di:waypoint x="1060" y="430" /><di:waypoint x="1100" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_9_di" bpmnElement="SF_9"><di:waypoint x="1220" y="430" /><di:waypoint x="1295" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_10_di" bpmnElement="SF_10"><di:waypoint x="1320" y="455" /><di:waypoint x="1320" y="557" /><bpmndi:BPMNLabel><dc:Bounds x="1326" y="497" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_11_di" bpmnElement="SF_11"><di:waypoint x="1345" y="430" /><di:waypoint x="1420" y="430" /><bpmndi:BPMNLabel><dc:Bounds x="1362" y="408" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_12_di" bpmnElement="SF_12"><di:waypoint x="1540" y="430" /><di:waypoint x="1580" y="430" /></bpmndi:BPMNEdge>
