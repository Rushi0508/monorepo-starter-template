<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_proof-of-delivery-processing" targetNamespace="https://app.drinksauero.com/docs" exporter="Sauero docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_proof-of-delivery-processing">
    <bpmn:participant id="P_mb" name="Manuel Brothers (distributor)" processRef="Proc_mb" />
    <bpmn:participant id="P_sauero" name="Sauerobase" processRef="Proc_sauero" />
    <bpmn:participant id="P_sd" name="SimplyDepo" />
    <bpmn:messageFlow id="MF_0" name="POD email" sourceRef="mb_send" targetRef="ev_in" />
    <bpmn:messageFlow id="MF_1" name="Order lookup" sourceRef="find" targetRef="P_sd" />
    <bpmn:messageFlow id="MF_2" name="Order details" sourceRef="P_sd" targetRef="find" />
    <bpmn:messageFlow id="MF_3" name="Delivery" sourceRef="record" targetRef="P_sd" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_mb" isExecutable="false">
    <bpmn:startEvent id="mb_start" name="Delivery made to the store"></bpmn:startEvent>
    <bpmn:sendTask id="mb_send" name="Email the signed delivery paperwork (POD)"></bpmn:sendTask>
    <bpmn:endEvent id="mb_end" name="Paperwork sent"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_0" name="" sourceRef="mb_start" targetRef="mb_send" />
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="mb_send" targetRef="mb_end" />
  </bpmn:process>
  <bpmn:process id="Proc_sauero" isExecutable="false">
    <bpmn:startEvent id="ev_in" name="New email in the shared inbox"><bpmn:messageEventDefinition id="MED_ev_in" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_mb" name="Manuel Brothers reply or pickup email?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_mb" name="Handled by Distributor Replenishment"></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_pod" name="Subject says POD and has a readable attachment?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_ign" name="Ignored, no record"></bpmn:endEvent>
    <bpmn:task id="store" name="Store as Pending on the Inbound Emails POD tab"></bpmn:task>
    <bpmn:task id="take" name="Take from the queue, oldest first"></bpmn:task>
    <bpmn:task id="read" name="Read each attachment (AI), or reuse the saved reading"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_ok" name="Invoice number and products found?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_f1" name="Email marked Failed"></bpmn:endEvent>
    <bpmn:task id="link" name="Link to the matching Sauero order (&quot;POD received&quot;)"></bpmn:task>
    <bpmn:sendTask id="find" name="Find the order in SimplyDepo by invoice number"></bpmn:sendTask>
    <bpmn:exclusiveGateway id="gw_found" name="Found in SimplyDepo?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_f2" name="Email marked Failed"></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_done" name="Already fully delivered?"></bpmn:exclusiveGateway>
    <bpmn:task id="skip" name="Mark &quot;POD processed&quot;, nothing sent"></bpmn:task>
    <bpmn:task id="match" name="Match lines to the order (AI), capped at what is outstanding"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_left" name="Anything left to deliver?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_f3" name="Email marked Failed"></bpmn:endEvent>
    <bpmn:sendTask id="record" name="Record the delivery in SimplyDepo, mark &quot;POD processed&quot;"></bpmn:sendTask>
    <bpmn:exclusiveGateway id="merge" name=""></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_more" name="More documents in the email?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_ok" name="Email marked Processed"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="ev_in" targetRef="gw_mb" />
    <bpmn:sequenceFlow id="SF_3" name="Yes" sourceRef="gw_mb" targetRef="end_mb" />
    <bpmn:sequenceFlow id="SF_4" name="No" sourceRef="gw_mb" targetRef="gw_pod" />
    <bpmn:sequenceFlow id="SF_5" name="No" sourceRef="gw_pod" targetRef="end_ign" />
    <bpmn:sequenceFlow id="SF_6" name="Yes" sourceRef="gw_pod" targetRef="store" />
    <bpmn:sequenceFlow id="SF_7" name="" sourceRef="store" targetRef="take" />
    <bpmn:sequenceFlow id="SF_8" name="" sourceRef="take" targetRef="read" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="read" targetRef="gw_ok" />
    <bpmn:sequenceFlow id="SF_10" name="No" sourceRef="gw_ok" targetRef="end_f1" />
    <bpmn:sequenceFlow id="SF_11" name="Yes" sourceRef="gw_ok" targetRef="link" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="link" targetRef="find" />
    <bpmn:sequenceFlow id="SF_13" name="" sourceRef="find" targetRef="gw_found" />
    <bpmn:sequenceFlow id="SF_14" name="No" sourceRef="gw_found" targetRef="end_f2" />
    <bpmn:sequenceFlow id="SF_15" name="Yes" sourceRef="gw_found" targetRef="gw_done" />
    <bpmn:sequenceFlow id="SF_16" name="Yes" sourceRef="gw_done" targetRef="skip" />
    <bpmn:sequenceFlow id="SF_17" name="No" sourceRef="gw_done" targetRef="match" />
    <bpmn:sequenceFlow id="SF_18" name="" sourceRef="match" targetRef="gw_left" />
    <bpmn:sequenceFlow id="SF_19" name="No" sourceRef="gw_left" targetRef="end_f3" />
    <bpmn:sequenceFlow id="SF_20" name="Yes" sourceRef="gw_left" targetRef="record" />
    <bpmn:sequenceFlow id="SF_21" name="" sourceRef="skip" targetRef="merge" />
    <bpmn:sequenceFlow id="SF_22" name="" sourceRef="record" targetRef="merge" />
    <bpmn:sequenceFlow id="SF_23" name="" sourceRef="merge" targetRef="gw_more" />
    <bpmn:sequenceFlow id="SF_24" name="Yes — next document" sourceRef="gw_more" targetRef="link" />
    <bpmn:sequenceFlow id="SF_25" name="No" sourceRef="gw_more" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_proof-of-delivery-processing">
    <bpmndi:BPMNPlane id="Plane_proof-of-delivery-processing" bpmnElement="Collab_proof-of-delivery-processing">
      <bpmndi:BPMNShape id="P_mb_di" bpmnElement="P_mb" isHorizontal="true"><dc:Bounds x="40" y="40" width="3020" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sauero_di" bpmnElement="P_sauero" isHorizontal="true"><dc:Bounds x="40" y="230" width="3020" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sd_di" bpmnElement="P_sd" isHorizontal="true"><dc:Bounds x="40" y="690" width="3020" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_start_di" bpmnElement="mb_start"><dc:Bounds x="182" y="97" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_send_di" bpmnElement="mb_send"><dc:Bounds x="300" y="77" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_end_di" bpmnElement="mb_end"><dc:Bounds x="502" y="97" width="36" height="36" /></bpmndi:BPMNShape>
