<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_order-intake-and-tracking" targetNamespace="https://app.drinksauero.com/docs" exporter="Sauero docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_order-intake-and-tracking">
    <bpmn:participant id="P_cust" name="Customer (online store, point of sale or SimplyDepo)" />
    <bpmn:participant id="P_shop" name="Shopify (online store)" processRef="Proc_shop" />
    <bpmn:participant id="P_sauero" name="Sauero" processRef="Proc_sauero" />
    <bpmn:participant id="P_bb" name="BlueBox (3PL warehouse)" processRef="Proc_bb" />
    <bpmn:messageFlow id="MF_0" name="Order" sourceRef="P_cust" targetRef="shop_start" />
    <bpmn:messageFlow id="MF_1" name="Real-time update" sourceRef="shop_send" targetRef="rt_start" />
    <bpmn:messageFlow id="MF_2" name="Changed orders" sourceRef="P_shop" targetRef="fr_read" />
    <bpmn:messageFlow id="MF_3" name="Dates, status, shipping charge" sourceRef="bb_record" targetRef="wh_read" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_shop" isExecutable="false">
    <bpmn:startEvent id="shop_start" name="Order placed or changed"><bpmn:messageEventDefinition id="MED_shop_start" /></bpmn:startEvent>
    <bpmn:sendTask id="shop_send" name="Send real-time update"></bpmn:sendTask>
    <bpmn:endEvent id="shop_end" name="Update sent"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_0" name="" sourceRef="shop_start" targetRef="shop_send" />
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="shop_send" targetRef="shop_end" />
  </bpmn:process>
  <bpmn:process id="Proc_sauero" isExecutable="false">
    <bpmn:laneSet id="LS_P_sauero">
      <bpmn:lane id="L_ops" name="Operations">
        <bpmn:flowNodeRef>ops_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ops_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sys" name="Sauerobase">
        <bpmn:flowNodeRef>rt_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rt_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_plain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fr_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wh_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wh_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wh_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wh_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rt_start" name="Real-time update received"><bpmn:messageEventDefinition id="MED_rt_start" /></bpmn:startEvent>
    <bpmn:task id="rt_save" name="Save order, payment, refunds and fulfilments"></bpmn:task>
    <bpmn:endEvent id="rt_end" name="On the Orders screen; channel, name and bundles not filled in yet"></bpmn:endEvent>
    <bpmn:startEvent id="fr_timer" name="Scheduled full order refresh"><bpmn:timerEventDefinition id="TED_fr_timer" /></bpmn:startEvent>
    <bpmn:task id="fr_read" name="Re-read every order changed since the last run"></bpmn:task>
    <bpmn:task id="fr_fill" name="Fill in channel, name and bundle breakdown; match everything to Shopify"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_sd" name="New SimplyDepo order?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="fr_plain" name="Order complete"></bpmn:endEvent>
    <bpmn:task id="fr_notify" name="Start the new order notification"></bpmn:task>
    <bpmn:endEvent id="fr_end" name="Order complete, distributor notified"></bpmn:endEvent>
    <bpmn:startEvent id="wh_timer" name="Scheduled warehouse refresh"><bpmn:timerEventDefinition id="TED_wh_timer" /></bpmn:startEvent>
    <bpmn:task id="wh_read" name="Bring in warehouse dates, delivery status and shipping charge"></bpmn:task>
    <bpmn:task id="wh_join" name="Join to the store order"></bpmn:task>
    <bpmn:endEvent id="wh_end" name="Delivery information available"></bpmn:endEvent>
    <bpmn:startEvent id="ops_start" name="Report opened"></bpmn:startEvent>
    <bpmn:task id="calc" name="Work out transit time, lead time and on-time from what is held now"></bpmn:task>
    <bpmn:endEvent id="ops_end" name="Figures shown on Orders and Fulfillment"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="rt_start" targetRef="rt_save" />
    <bpmn:sequenceFlow id="SF_3" name="" sourceRef="rt_save" targetRef="rt_end" />
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="fr_timer" targetRef="fr_read" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="fr_read" targetRef="fr_fill" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="fr_fill" targetRef="gw_sd" />
    <bpmn:sequenceFlow id="SF_7" name="No" sourceRef="gw_sd" targetRef="fr_plain" />
    <bpmn:sequenceFlow id="SF_8" name="Yes" sourceRef="gw_sd" targetRef="fr_notify" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="fr_notify" targetRef="fr_end" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="wh_timer" targetRef="wh_read" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="wh_read" targetRef="wh_join" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="wh_join" targetRef="wh_end" />
    <bpmn:sequenceFlow id="SF_13" name="" sourceRef="ops_start" targetRef="calc" />
    <bpmn:sequenceFlow id="SF_14" name="" sourceRef="calc" targetRef="ops_end" />
  </bpmn:process>
  <bpmn:process id="Proc_bb" isExecutable="false">
    <bpmn:startEvent id="bb_start" name="Order to ship"></bpmn:startEvent>
    <bpmn:task id="bb_pick" name="Pick, pack and ship"></bpmn:task>
    <bpmn:task id="bb_record" name="Record delivery"></bpmn:task>
    <bpmn:endEvent id="bb_end" name="Delivered"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_15" name="" sourceRef="bb_start" targetRef="bb_pick" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="bb_pick" targetRef="bb_record" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="bb_record" targetRef="bb_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_order-intake-and-tracking">
    <bpmndi:BPMNPlane id="Plane_order-intake-and-tracking" bpmnElement="Collab_order-intake-and-tracking">
      <bpmndi:BPMNShape id="P_cust_di" bpmnElement="P_cust" isHorizontal="true"><dc:Bounds x="40" y="40" width="2220" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_shop_di" bpmnElement="P_shop" isHorizontal="true"><dc:Bounds x="40" y="150" width="2220" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sauero_di" bpmnElement="P_sauero" isHorizontal="true"><dc:Bounds x="40" y="340" width="2220" height="570" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_ops_di" bpmnElement="L_ops" isHorizontal="true"><dc:Bounds x="70" y="340" width="2190" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sys_di" bpmnElement="L_sys" isHorizontal="true"><dc:Bounds x="70" y="470" width="2190" height="440" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_bb_di" bpmnElement="P_bb" isHorizontal="true"><dc:Bounds x="40" y="950" width="2220" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shop_start_di" bpmnElement="shop_start"><dc:Bounds x="182" y="207" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shop_send_di" bpmnElement="shop_send"><dc:Bounds x="300" y="187" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shop_end_di" bpmnElement="shop_end"><dc:Bounds x="502" y="207" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rt_start_di" bpmnElement="rt_start"><dc:Bounds x="342" y="527" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rt_save_di" bpmnElement="rt_save"><dc:Bounds x="460" y="507" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rt_end_di" bpmnElement="rt_end"><dc:Bounds x="662" y="527" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_timer_di" bpmnElement="fr_timer"><dc:Bounds x="822" y="672" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_read_di" bpmnElement="fr_read"><dc:Bounds x="940" y="652" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_fill_di" bpmnElement="fr_fill"><dc:Bounds x="1100" y="652" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sd_di" bpmnElement="gw_sd" isMarkerVisible="true"><dc:Bounds x="1295" y="665" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_plain_di" bpmnElement="fr_plain"><dc:Bounds x="1398" y="527" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1440" y="530" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_notify_di" bpmnElement="fr_notify"><dc:Bounds x="1420" y="652" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fr_end_di" bpmnElement="fr_end"><dc:Bounds x="1622" y="672" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wh_timer_di" bpmnElement="wh_timer"><dc:Bounds x="982" y="817" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wh_read_di" bpmnElement="wh_read"><dc:Bounds x="1100" y="797" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wh_join_di" bpmnElement="wh_join"><dc:Bounds x="1260" y="797" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wh_end_di" bpmnElement="wh_end"><dc:Bounds x="1462" y="817" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ops_start_di" bpmnElement="ops_start"><dc:Bounds x="1782" y="387" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1750" y="351" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calc_di" bpmnElement="calc"><dc:Bounds x="1900" y="652" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ops_end_di" bpmnElement="ops_end"><dc:Bounds x="2102" y="387" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bb_start_di" bpmnElement="bb_start"><dc:Bounds x="822" y="1007" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bb_pick_di" bpmnElement="bb_pick"><dc:Bounds x="940" y="987" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bb_record_di" bpmnElement="bb_record"><dc:Bounds x="1100" y="987" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bb_end_di" bpmnElement="bb_end"><dc:Bounds x="1302" y="1007" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_0_di" bpmnElement="SF_0"><di:waypoint x="218" y="225" /><di:waypoint x="300" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1"><di:waypoint x="420" y="225" /><di:waypoint x="502" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2"><di:waypoint x="378" y="545" /><di:waypoint x="460" y="545" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_3_di" bpmnElement="SF_3"><di:waypoint x="580" y="545" /><di:waypoint x="662" y="545" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_4_di" bpmnElement="SF_4"><di:waypoint x="858" y="690" /><di:waypoint x="940" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5"><di:waypoint x="1060" y="690" /><di:waypoint x="1100" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6"><di:waypoint x="1220" y="690" /><di:waypoint x="1295" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_7_di" bpmnElement="SF_7"><di:waypoint x="1320" y="665" /><di:waypoint x="1320" y="545" /><di:waypoint x="1398" y="545" /><bpmndi:BPMNLabel><dc:Bounds x="1326" y="596" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_8_di" bpmnElement="SF_8"><di:waypoint x="1345" y="690" /><di:waypoint x="1420" y="690" /><bpmndi:BPMNLabel><dc:Bounds x="1362" y="668" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_9_di" bpmnElement="SF_9"><di:waypoint x="1540" y="690" /><di:waypoint x="1622" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_10_di" bpmnElement="SF_10"><di:waypoint x="1018" y="835" /><di:waypoint x="1100" y="835" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_11_di" bpmnElement="SF_11"><di:waypoint x="1220" y="835" /><di:waypoint x="1260" y="835" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_12_di" bpmnElement="SF_12"><di:waypoint x="1380" y="835" /><di:waypoint x="1462" y="835" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_13_di" bpmnElement="SF_13"><di:waypoint x="1800" y="423" /><di:waypoint x="1800" y="690" /><di:waypoint x="1900" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_14_di" bpmnElement="SF_14"><di:waypoint x="1960" y="652" /><di:waypoint x="1960" y="405" /><di:waypoint x="2102" y="405" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_15_di" bpmnElement="SF_15"><di:waypoint x="858" y="1025" /><di:waypoint x="940" y="1025" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_16_di" bpmnElement="SF_16"><di:waypoint x="1060" y="1025" /><di:waypoint x="1100" y="1025" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_17_di" bpmnElement="SF_17"><di:waypoint x="1220" y="1025" /><di:waypoint x="1302" y="1025" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_0_di" bpmnElement="MF_0"><di:waypoint x="200" y="110" /><di:waypoint x="200" y="207" /><bpmndi:BPMNLabel><dc:Bounds x="206" y="121" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1"><di:waypoint x="360" y="263" /><di:waypoint x="360" y="527" /><bpmndi:BPMNLabel><dc:Bounds x="366" y="311" width="112" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_2_di" bpmnElement="MF_2"><di:waypoint x="1000" y="300" /><di:waypoint x="1000" y="652" /><bpmndi:BPMNLabel><dc:Bounds x="1006" y="311" width="98" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_3_di" bpmnElement="MF_3"><di:waypoint x="1160" y="987" /><di:waypoint x="1160" y="873" /><bpmndi:BPMNLabel><dc:Bounds x="1166" y="913" width="150" height="34" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
