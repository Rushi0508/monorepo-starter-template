<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_replenishment" targetNamespace="https://app.drinksauero.com/docs" exporter="Sauero docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_replenishment">
    <bpmn:participant id="P_mb" name="Manuel Brothers (distributor)" processRef="Proc_mb" />
    <bpmn:participant id="P_sauero" name="Sauero" processRef="Proc_sauero" />
    <bpmn:participant id="P_bb" name="BlueBox / iDrive (3PL warehouse)" processRef="Proc_bb" />
    <bpmn:participant id="P_shop" name="Shopify" />
    <bpmn:messageFlow id="MF_0" name="Pickup order" sourceRef="sys_place" targetRef="bb_start" />
    <bpmn:messageFlow id="MF_1" name="Accepted / rejected" sourceRef="bb_accept" targetRef="sys_place" />
    <bpmn:messageFlow id="MF_2" name="Pickup request" sourceRef="sys_email" targetRef="mb_start" />
    <bpmn:messageFlow id="MF_3" name="Reply" sourceRef="mb_reply" targetRef="ev_reply" />
    <bpmn:messageFlow id="MF_4" name="Bill of Lading" sourceRef="mb_bol" targetRef="ev_bol" />
    <bpmn:messageFlow id="MF_5" name="Status via BlueBox sync" sourceRef="bb_ship" targetRef="sys_status" />
    <bpmn:messageFlow id="MF_6" name="Stock update" sourceRef="sys_stock" targetRef="P_shop" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_mb" isExecutable="false">
    <bpmn:startEvent id="mb_start" name="Pickup request received"><bpmn:messageEventDefinition id="MED_mb_start" /></bpmn:startEvent>
    <bpmn:sendTask id="mb_reply" name="Reply to confirm the order"></bpmn:sendTask>
    <bpmn:task id="mb_collect" name="Collect the pallet at iDrive (Monday)"></bpmn:task>
    <bpmn:sendTask id="mb_bol" name="Email the Bill of Lading"></bpmn:sendTask>
    <bpmn:endEvent id="mb_end" name="Pickup done"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_0" name="" sourceRef="mb_start" targetRef="mb_reply" />
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="mb_reply" targetRef="mb_collect" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="mb_collect" targetRef="mb_bol" />
    <bpmn:sequenceFlow id="SF_3" name="" sourceRef="mb_bol" targetRef="mb_end" />
  </bpmn:process>
  <bpmn:process id="Proc_sauero" isExecutable="false">
    <bpmn:laneSet id="LS_P_sauero">
      <bpmn:lane id="L_ops" name="Operations">
        <bpmn:flowNodeRef>ops_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ops_create</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sys" name="Sauerobase">
        <bpmn:flowNodeRef>sys_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_acc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_noemail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_judge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_bol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_ocr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_picked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_picked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sys_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_synced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_skip</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ops_start" name="Distributor needs stock"></bpmn:startEvent>
    <bpmn:task id="ops_create" name="Create transfer: products, quantities, pickup email on/off"></bpmn:task>
    <bpmn:task id="sys_number" name="Generate transfer number (MB-####)"></bpmn:task>
    <bpmn:sendTask id="sys_place" name="Place pickup-only order in BlueBox"></bpmn:sendTask>
    <bpmn:exclusiveGateway id="gw_acc" name="Accepted by BlueBox?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_err" name="Error shown, nothing saved"></bpmn:endEvent>
    <bpmn:task id="sys_save" name="Save transfer and work out the pickup Monday"></bpmn:task>
    <bpmn:parallelGateway id="gw_split" name=""></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw_email" name="Pickup email ticked?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_noemail" name="No email sent"></bpmn:endEvent>
    <bpmn:sendTask id="sys_email" name="Email pickup request from the shared inbox"></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ev_reply" name="Reply received"><bpmn:messageEventDefinition id="MED_ev_reply" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="sys_judge" name="Check the reply (AI)"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_ack" name="Genuine confirmation?"></bpmn:exclusiveGateway>
    <bpmn:task id="sys_ack" name="Mark Email ack"></bpmn:task>
    <bpmn:intermediateCatchEvent id="ev_bol" name="Bill of Lading received"><bpmn:messageEventDefinition id="MED_ev_bol" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="sys_ocr" name="Read MB numbers on the document"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_ready" name="Request sent and acknowledged?"></bpmn:exclusiveGateway>
    <bpmn:task id="sys_picked" name="Mark Picked up"></bpmn:task>
    <bpmn:endEvent id="end_picked" name="Picked up"></bpmn:endEvent>
    <bpmn:endEvent id="end_failed" name="Pickup email Failed"></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ev_timer" name="Scheduled status check"><bpmn:timerEventDefinition id="TED_ev_timer" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="sys_status" name="Read BlueBox order status (Sauero's synced copy)"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_status" name="Order status?"></bpmn:exclusiveGateway>
    <bpmn:sendTask id="sys_stock" name="Add quantities to the Manuel Brothers location"></bpmn:sendTask>
    <bpmn:endEvent id="end_synced" name="Synced"></bpmn:endEvent>
    <bpmn:endEvent id="end_skip" name="Skipped (cancelled)"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_4" name="" sourceRef="ops_start" targetRef="ops_create" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="ops_create" targetRef="sys_number" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="sys_number" targetRef="sys_place" />
    <bpmn:sequenceFlow id="SF_7" name="" sourceRef="sys_place" targetRef="gw_acc" />
    <bpmn:sequenceFlow id="SF_8" name="No" sourceRef="gw_acc" targetRef="end_err" />
    <bpmn:sequenceFlow id="SF_9" name="Yes" sourceRef="gw_acc" targetRef="sys_save" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="sys_save" targetRef="gw_split" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="gw_split" targetRef="gw_email" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="gw_split" targetRef="ev_timer" />
    <bpmn:sequenceFlow id="SF_13" name="No" sourceRef="gw_email" targetRef="end_noemail" />
    <bpmn:sequenceFlow id="SF_14" name="Yes" sourceRef="gw_email" targetRef="sys_email" />
    <bpmn:sequenceFlow id="SF_15" name="" sourceRef="sys_email" targetRef="ev_reply" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="ev_reply" targetRef="sys_judge" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="sys_judge" targetRef="gw_ack" />
    <bpmn:sequenceFlow id="SF_18" name="No — wait for the next reply" sourceRef="gw_ack" targetRef="ev_reply" />
    <bpmn:sequenceFlow id="SF_19" name="Yes" sourceRef="gw_ack" targetRef="sys_ack" />
    <bpmn:sequenceFlow id="SF_20" name="" sourceRef="sys_ack" targetRef="ev_bol" />
    <bpmn:sequenceFlow id="SF_21" name="" sourceRef="ev_bol" targetRef="sys_ocr" />
    <bpmn:sequenceFlow id="SF_22" name="" sourceRef="sys_ocr" targetRef="gw_ready" />
    <bpmn:sequenceFlow id="SF_23" name="No" sourceRef="gw_ready" targetRef="end_failed" />
    <bpmn:sequenceFlow id="SF_24" name="Yes" sourceRef="gw_ready" targetRef="sys_picked" />
    <bpmn:sequenceFlow id="SF_25" name="" sourceRef="sys_picked" targetRef="end_picked" />
    <bpmn:sequenceFlow id="SF_26" name="" sourceRef="ev_timer" targetRef="sys_status" />
    <bpmn:sequenceFlow id="SF_27" name="" sourceRef="sys_status" targetRef="gw_status" />
    <bpmn:sequenceFlow id="SF_28" name="Still open" sourceRef="gw_status" targetRef="ev_timer" />
    <bpmn:sequenceFlow id="SF_29" name="Shipped or delivered" sourceRef="gw_status" targetRef="sys_stock" />
    <bpmn:sequenceFlow id="SF_30" name="Cancelled" sourceRef="gw_status" targetRef="end_skip" />
    <bpmn:sequenceFlow id="SF_31" name="" sourceRef="sys_stock" targetRef="end_synced" />
  </bpmn:process>
  <bpmn:process id="Proc_bb" isExecutable="false">
    <bpmn:startEvent id="bb_start" name="Pickup order received"><bpmn:messageEventDefinition id="MED_bb_start" /></bpmn:startEvent>
    <bpmn:sendTask id="bb_accept" name="Accept or reject the order"></bpmn:sendTask>
    <bpmn:task id="bb_prep" name="Prepare the pallet"></bpmn:task>
    <bpmn:sendTask id="bb_ship" name="Hand over pallet, mark shipped"></bpmn:sendTask>
    <bpmn:endEvent id="bb_end" name="Order shipped"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_32" name="" sourceRef="bb_start" targetRef="bb_accept" />
    <bpmn:sequenceFlow id="SF_33" name="" sourceRef="bb_accept" targetRef="bb_prep" />
    <bpmn:sequenceFlow id="SF_34" name="" sourceRef="bb_prep" targetRef="bb_ship" />
    <bpmn:sequenceFlow id="SF_35" name="" sourceRef="bb_ship" targetRef="bb_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_replenishment">
    <bpmndi:BPMNPlane id="Plane_replenishment" bpmnElement="Collab_replenishment">
      <bpmndi:BPMNShape id="P_mb_di" bpmnElement="P_mb" isHorizontal="true"><dc:Bounds x="40" y="40" width="3020" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sauero_di" bpmnElement="P_sauero" isHorizontal="true"><dc:Bounds x="40" y="250" width="3020" height="620" /></bpmndi:BPMNShape>
