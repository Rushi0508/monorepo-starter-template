      <bpmndi:BPMNEdge id="SF_12_di" bpmnElement="SF_12"><di:waypoint x="1160" y="575" /><di:waypoint x="1160" y="700" /><di:waypoint x="1302" y="700" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_13_di" bpmnElement="SF_13"><di:waypoint x="1320" y="525" /><di:waypoint x="1320" y="463" /><bpmndi:BPMNLabel><dc:Bounds x="1326" y="485" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_14_di" bpmnElement="SF_14"><di:waypoint x="1345" y="550" /><di:waypoint x="1420" y="550" /><bpmndi:BPMNLabel><dc:Bounds x="1362" y="528" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_15_di" bpmnElement="SF_15"><di:waypoint x="1540" y="550" /><di:waypoint x="1622" y="550" /></bpmndi:BPMNEdge>
