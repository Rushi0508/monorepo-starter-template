      <bpmndi:BPMNShape id="bb_end_di" bpmnElement="bb_end"><dc:Bounds x="1622" y="977" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_0_di" bpmnElement="SF_0"><di:waypoint x="1498" y="125" /><di:waypoint x="1660" y="125" /></bpmndi:BPMNEdge>
