      <bpmndi:BPMNEdge id="SF_8_di" bpmnElement="SF_8"><di:waypoint x="840" y="575" /><di:waypoint x="840" y="682" /><bpmndi:BPMNLabel><dc:Bounds x="846" y="620" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_9_di" bpmnElement="SF_9"><di:waypoint x="865" y="550" /><di:waypoint x="940" y="550" /><bpmndi:BPMNLabel><dc:Bounds x="882" y="528" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_10_di" bpmnElement="SF_10"><di:waypoint x="1060" y="550" /><di:waypoint x="1135" y="550" /></bpmndi:BPMNEdge>
