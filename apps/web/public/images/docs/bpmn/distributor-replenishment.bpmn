      <bpmndi:BPMNShape id="ev_timer_di" bpmnElement="ev_timer"><dc:Bounds x="1302" y="682" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sys_status_di" bpmnElement="sys_status"><dc:Bounds x="1420" y="662" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_status_di" bpmnElement="gw_status" isMarkerVisible="true"><dc:Bounds x="1615" y="675" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1529" y="729" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sys_stock_di" bpmnElement="sys_stock"><dc:Bounds x="1820" y="662" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_synced_di" bpmnElement="end_synced"><dc:Bounds x="2022" y="682" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_skip_di" bpmnElement="end_skip"><dc:Bounds x="1622" y="792" width="36" height="36" /></bpmndi:BPMNShape>
