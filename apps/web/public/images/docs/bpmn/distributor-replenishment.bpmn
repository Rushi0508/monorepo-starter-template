      <bpmndi:BPMNShape id="end_noemail_di" bpmnElement="end_noemail"><dc:Bounds x="1302" y="427" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1344" y="430" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sys_email_di" bpmnElement="sys_email"><dc:Bounds x="1420" y="512" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ev_reply_di" bpmnElement="ev_reply"><dc:Bounds x="1622" y="532" width="36" height="36" /></bpmndi:BPMNShape>
