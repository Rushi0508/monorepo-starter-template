<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_new-order-notification" targetNamespace="https://app.drinksauero.com/docs" exporter="Sauero docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_new-order-notification">
    <bpmn:participant id="P_mb" name="Manuel Brothers (distributor)" processRef="Proc_mb" />
    <bpmn:participant id="P_sauero" name="Sauerobase" processRef="Proc_sauero" />
    <bpmn:participant id="P_sd" name="SimplyDepo" />
    <bpmn:messageFlow id="MF_0" name="Order lookup" sourceRef="lookup" targetRef="P_sd" />
    <bpmn:messageFlow id="MF_1" name="Payment, SKUs, PDF" sourceRef="P_sd" targetRef="lookup" />
    <bpmn:messageFlow id="MF_2" name="New order email" sourceRef="send" targetRef="mb_start" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_mb" isExecutable="false">
    <bpmn:startEvent id="mb_start" name="New order email received"><bpmn:messageEventDefinition id="MED_mb_start" /></bpmn:startEvent>
    <bpmn:task id="mb_plan" name="Plan the delivery"></bpmn:task>
    <bpmn:endEvent id="mb_end" name="Delivery planned"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_0" name="" sourceRef="mb_start" targetRef="mb_plan" />
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="mb_plan" targetRef="mb_end" />
  </bpmn:process>
  <bpmn:process id="Proc_sauero" isExecutable="false">
    <bpmn:startEvent id="start" name="Full order refresh sees an order for the first time"></bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_sd" name="SimplyDepo order?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_sd" name="Nothing happens"></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_age" name="Less than 24 hours old?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_age" name="Nothing happens"></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_cxl" name="Cancelled?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_cxl" name="Nothing happens"></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_addr" name="Primary distributor email set?"></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_addr" name="Silently skipped"></bpmn:endEvent>
    <bpmn:sendTask id="lookup" name="Look the order up in SimplyDepo (name without &quot;#&quot;)"></bpmn:sendTask>
    <bpmn:exclusiveGateway id="gw_found" name="Lookup succeeded?"></bpmn:exclusiveGateway>
    <bpmn:task id="full" name="Build email with payment status, SimplyDepo SKUs and order PDF"></bpmn:task>
    <bpmn:task id="basic" name="Build email without payment line or PDF, using Shopify SKUs"></bpmn:task>
    <bpmn:exclusiveGateway id="gw_merge" name=""></bpmn:exclusiveGateway>
    <bpmn:sendTask id="send" name="Send from the shared Gmail inbox to Primary, copying every CC"></bpmn:sendTask>
    <bpmn:task id="record" name="Record send time and Gmail conversation on the order"></bpmn:task>
    <bpmn:endEvent id="end" name="Email flow shows &quot;Delivery request&quot;"></bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="start" targetRef="gw_sd" />
    <bpmn:sequenceFlow id="SF_3" name="No" sourceRef="gw_sd" targetRef="end_sd" />
    <bpmn:sequenceFlow id="SF_4" name="Yes" sourceRef="gw_sd" targetRef="gw_age" />
    <bpmn:sequenceFlow id="SF_5" name="No" sourceRef="gw_age" targetRef="end_age" />
    <bpmn:sequenceFlow id="SF_6" name="Yes" sourceRef="gw_age" targetRef="gw_cxl" />
    <bpmn:sequenceFlow id="SF_7" name="Yes" sourceRef="gw_cxl" targetRef="end_cxl" />
    <bpmn:sequenceFlow id="SF_8" name="No" sourceRef="gw_cxl" targetRef="gw_addr" />
    <bpmn:sequenceFlow id="SF_9" name="No" sourceRef="gw_addr" targetRef="end_addr" />
    <bpmn:sequenceFlow id="SF_10" name="Yes" sourceRef="gw_addr" targetRef="lookup" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="lookup" targetRef="gw_found" />
    <bpmn:sequenceFlow id="SF_12" name="Yes" sourceRef="gw_found" targetRef="full" />
    <bpmn:sequenceFlow id="SF_13" name="No" sourceRef="gw_found" targetRef="basic" />
    <bpmn:sequenceFlow id="SF_14" name="" sourceRef="full" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="SF_15" name="" sourceRef="basic" targetRef="gw_merge" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="gw_merge" targetRef="send" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="send" targetRef="record" />
    <bpmn:sequenceFlow id="SF_18" name="" sourceRef="record" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_new-order-notification">
    <bpmndi:BPMNPlane id="Plane_new-order-notification" bpmnElement="Collab_new-order-notification">
      <bpmndi:BPMNShape id="P_mb_di" bpmnElement="P_mb" isHorizontal="true"><dc:Bounds x="40" y="40" width="2060" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sauero_di" bpmnElement="P_sauero" isHorizontal="true"><dc:Bounds x="40" y="230" width="2060" height="330" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_sd_di" bpmnElement="P_sd" isHorizontal="true"><dc:Bounds x="40" y="600" width="2060" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_start_di" bpmnElement="mb_start"><dc:Bounds x="1622" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1590" y="61" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_plan_di" bpmnElement="mb_plan"><dc:Bounds x="1740" y="77" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mb_end_di" bpmnElement="mb_end"><dc:Bounds x="1942" y="97" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="182" y="377" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="92" y="417" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sd_di" bpmnElement="gw_sd" isMarkerVisible="true"><dc:Bounds x="335" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_sd_di" bpmnElement="end_sd"><dc:Bounds x="342" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="384" y="265" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_age_di" bpmnElement="gw_age" isMarkerVisible="true"><dc:Bounds x="495" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_age_di" bpmnElement="end_age"><dc:Bounds x="502" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="544" y="265" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_cxl_di" bpmnElement="gw_cxl" isMarkerVisible="true"><dc:Bounds x="655" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_cxl_di" bpmnElement="end_cxl"><dc:Bounds x="662" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="704" y="265" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_addr_di" bpmnElement="gw_addr" isMarkerVisible="true"><dc:Bounds x="815" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_addr_di" bpmnElement="end_addr"><dc:Bounds x="822" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="864" y="265" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lookup_di" bpmnElement="lookup"><dc:Bounds x="940" y="357" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_found_di" bpmnElement="gw_found" isMarkerVisible="true"><dc:Bounds x="1135" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1110" y="334" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="full_di" bpmnElement="full"><dc:Bounds x="1260" y="357" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="basic_di" bpmnElement="basic"><dc:Bounds x="1260" y="467" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_di" bpmnElement="gw_merge" isMarkerVisible="true"><dc:Bounds x="1455" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_di" bpmnElement="send"><dc:Bounds x="1580" y="357" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="record_di" bpmnElement="record"><dc:Bounds x="1740" y="357" width="120" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1942" y="377" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_0_di" bpmnElement="SF_0"><di:waypoint x="1658" y="115" /><di:waypoint x="1740" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1"><di:waypoint x="1860" y="115" /><di:waypoint x="1942" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2"><di:waypoint x="218" y="395" /><di:waypoint x="335" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_3_di" bpmnElement="SF_3"><di:waypoint x="360" y="370" /><di:waypoint x="360" y="298" /><bpmndi:BPMNLabel><dc:Bounds x="366" y="325" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_4_di" bpmnElement="SF_4"><di:waypoint x="385" y="395" /><di:waypoint x="495" y="395" /><bpmndi:BPMNLabel><dc:Bounds x="420" y="373" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5"><di:waypoint x="520" y="370" /><di:waypoint x="520" y="298" /><bpmndi:BPMNLabel><dc:Bounds x="526" y="325" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6"><di:waypoint x="545" y="395" /><di:waypoint x="655" y="395" /><bpmndi:BPMNLabel><dc:Bounds x="580" y="373" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_7_di" bpmnElement="SF_7"><di:waypoint x="680" y="370" /><di:waypoint x="680" y="298" /><bpmndi:BPMNLabel><dc:Bounds x="686" y="325" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_8_di" bpmnElement="SF_8"><di:waypoint x="705" y="395" /><di:waypoint x="815" y="395" /><bpmndi:BPMNLabel><dc:Bounds x="740" y="373" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_9_di" bpmnElement="SF_9"><di:waypoint x="840" y="370" /><di:waypoint x="840" y="298" /><bpmndi:BPMNLabel><dc:Bounds x="846" y="325" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_10_di" bpmnElement="SF_10"><di:waypoint x="865" y="395" /><di:waypoint x="940" y="395" /><bpmndi:BPMNLabel><dc:Bounds x="882" y="373" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_11_di" bpmnElement="SF_11"><di:waypoint x="1060" y="395" /><di:waypoint x="1135" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_12_di" bpmnElement="SF_12"><di:waypoint x="1185" y="395" /><di:waypoint x="1260" y="395" /><bpmndi:BPMNLabel><dc:Bounds x="1202" y="373" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_13_di" bpmnElement="SF_13"><di:waypoint x="1160" y="420" /><di:waypoint x="1160" y="505" /><di:waypoint x="1260" y="505" /><bpmndi:BPMNLabel><dc:Bounds x="1166" y="454" width="40" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_14_di" bpmnElement="SF_14"><di:waypoint x="1380" y="395" /><di:waypoint x="1455" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_15_di" bpmnElement="SF_15"><di:waypoint x="1380" y="505" /><di:waypoint x="1480" y="505" /><di:waypoint x="1480" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_16_di" bpmnElement="SF_16"><di:waypoint x="1505" y="395" /><di:waypoint x="1580" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_17_di" bpmnElement="SF_17"><di:waypoint x="1700" y="395" /><di:waypoint x="1740" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_18_di" bpmnElement="SF_18"><di:waypoint x="1860" y="395" /><di:waypoint x="1942" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_0_di" bpmnElement="MF_0"><di:waypoint x="970" y="433" /><di:waypoint x="970" y="600" /><bpmndi:BPMNLabel><dc:Bounds x="880" y="571" width="84" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_1_di" bpmnElement="MF_1"><di:waypoint x="1030" y="600" /><di:waypoint x="1030" y="433" /><bpmndi:BPMNLabel><dc:Bounds x="1036" y="571" width="126" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_2_di" bpmnElement="MF_2"><di:waypoint x="1640" y="357" /><di:waypoint x="1640" y="133" /><bpmndi:BPMNLabel><dc:Bounds x="1646" y="201" width="105" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
