{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testRegex": ".*\\.service\\.spec\\.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"transformIgnorePatterns": ["/node_modules/", "../prisma/client/"],
	"verbose": true,
	"collectCoverage": true,
	"coverageProvider": "v8",
	"collectCoverageFrom": [
		"**/*service.(t|j)s",
		"!**/*.spec.ts",
		"!**/*.controller.spec.ts",
		"!**/*.e2e-spec.ts",
		"!**/main.ts",
		"!**/node_modules/**",
		"!**/dist/**",
		"!**/coverage/**",
		"!**/test/**"
	],
	"coverageThreshold": {
		"global": {
			"branches": 100,
			"functions": 100,
			"lines": 80,
			"statements": 100
		}
	},
	"coverageDirectory": "./coverage",
	"coverageReporters": ["text", "lcov", "html"],
	"testEnvironment": "node",
	"moduleNameMapper": {
		"^src/(.*)$": "<rootDir>/src/$1",
		"^prisma/(.*)$": "<rootDir>/prisma/$1"
	},
	"moduleDirectories": ["node_modules", "src"],
	"testTimeout": 10000,
	"setupFilesAfterEnv": ["<rootDir>/test/setup-unit.ts"]
}
