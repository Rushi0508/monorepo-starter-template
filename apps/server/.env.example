NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Hosted databases that need SSL: append ?sslmode=no-verify
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001

FRONTEND_URL=http://localhost:3000
CORS_URLS=http://localhost:3000

# Production only: sends the sign-in OTP by email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Starter
