{
	"compilerOptions": {
		"module": "commonjs",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "ES2023",
		"sourceMap": true,
		"outDir": "./dist",
		"paths": {
			"src/*": ["./src/*"],
			"test/*": ["./test/*"]
		},
		"incremental": true,
		"skipLibCheck": true,
		"strict": false,
		"strictNullChecks": true,
		"types": ["node", "jest"],
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": false,
		"strictBindCallApply": false,
		"noFallthroughCasesInSwitch": false
	}
}
