	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "nest build",
		"format": "biome format --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "biome format \"src/**/*.ts\" \"test/**/*.ts\"",
		"dev": "heizen-secrets run -- nest start --watch",
		"debug": "nest start --debug --watch",
		"start": "node dist/main --port 3001",
		"lint": "biome check --fix \"{src,apps,libs,test}/**/*.ts\"",
		"test:unit": "jest --coverage --config ./test/jest-unit.json",
		"typecheck": "tsc --noEmit",
		"shopify:register-subscriptions": "heizen-secrets run -- ts-node src/shopify/scripts/register-shopify-subscriptions.ts",
		"shopify:get-subscriptions": "heizen-secrets run -- ts-node src/shopify/scripts/get-shopify-subscriptions.ts",
		"shopify:delete-subscriptions": "heizen-secrets run -- ts-node src/shopify/scripts/delete-shopify-subscriptions.ts"
	},
