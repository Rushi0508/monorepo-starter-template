{
	"name": "server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=20.17.0",
		"npm": "only-allow pnpm",
		"yarn": "only-allow pnpm"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "nest build",
		"format": "biome format --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "biome format \"src/**/*.ts\" \"test/**/*.ts\"",
		"dev": "nest start --watch",
		"debug": "nest start --debug --watch",
		"start": "node dist/main --port 3001",
		"lint": "biome check --fix \"{src,apps,libs,test}/**/*.ts\"",
		"test:unit": "jest --coverage --config ./test/jest-unit.json",
		"typecheck": "tsc --noEmit",
		"shopify:register-subscriptions": "ts-node src/shopify/scripts/register-shopify-subscriptions.ts",
		"shopify:get-subscriptions": "ts-node src/shopify/scripts/get-shopify-subscriptions.ts",
		"shopify:delete-subscriptions": "ts-node src/shopify/scripts/delete-shopify-subscriptions.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/event-emitter": "^3.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.1.4",
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@repo/constants": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/mail": "workspace:*",
		"@repo/types": "workspace:*",
		"@repo/utils": "workspace:*",
		"@thallesp/nestjs-better-auth": "^2.4.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^18.0.8",
		"express": "^5.1.0",
		"nestjs-pino": "^4.5.0",
		"pg": "^8.16.3",
		"pino-pretty": "^13.0.0",
		"prisma": "^7.2.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@repo/typescript-config": "workspace:*",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.16.0",
		"@types/supertest": "^7.2.0",
		"jest": "^30.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0"
	}
