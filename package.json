{
	"name": "monorepo-starter-template",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "./scripts/setup-hooks.sh",
		"build": "turbo run build",
		"start": "turbo run start",
		"dev": "turbo run dev",
		"lint": "biome check --fix --max-diagnostics 120",
		"lint:check": "biome check",
		"test:unit": "turbo run test:unit",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:deploy": "turbo run db:deploy",
		"db:studio": "turbo run db:studio",
		"format:check": "biome format",
		"format:fix": "biome format --write",
		"typecheck": "turbo run typecheck",
		"find-deadcode": "turbo run find-deadcode",
		"gitleaks": "./scripts/gitleaks.sh",
		"depcruise": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err"
	},
	"dependencies": {
		"better-auth": "^1.7.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^0.563.0",
		"next-themes": "^0.4.4",
		"react": "^19.3.1",
		"react-day-picker": "9.7.0",
		"react-hook-form": "7.90.0",
		"react-phone-number-input": "^3.4.18",
		"react-resizable-panels": "^4.14.8",
		"recharts": "^2.15.4",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.2.4",
		"vaul": "^1.1.2",
		"zod": "^4.6.7"
	},
	"pnpm": {
		"overrides": {
			"react-hook-form": "7.90.0",
			"file-type": "^21.3.2",
			"nodemailer": "^10.0.9",
			"multer": "^2.4.0",
			"lodash": "^4.18.0",
			"path-to-regexp": "^8.4.0",
			"picomatch": "^4.0.4",
			"@xhmikosr/decompress@^10": "^10.2.2",
			"brace-expansion@^1": "^1.1.21",
			"brace-expansion@^2": "^2.1.7",
			"brace-expansion@^5": "^5.0.12",
			"fast-uri@^3": "^3.1.8",
			"js-yaml@^3": "^3.15.2",
			"js-yaml@^4": "^4.3.2",
			"js-yaml@^5": "^5.4.1",
			"mysql2@^3": "^3.23.1",
			"nanoid@^3": "^3.3.18",
			"piscina@^4": "^4.9.4",
			"qs@^6": "^6.16.0"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@repo/typescript-config": "workspace:*",
		"@types/jest": "^30.0.0",
		"baseline-browser-mapping": "^2.11.30",
		"dependency-cruiser": "^18.7.0",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.10",
		"typescript": "^6.0.3"
	}
}
