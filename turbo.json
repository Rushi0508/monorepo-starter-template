{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"envMode": "loose",
	"concurrency": "20",
	"globalDependencies": ["docs/**", "skills/**"],
	"tasks": {
		"start": {
			"dependsOn": ["^start"]
		},
		"build": {
			"dependsOn": ["^build", "db:generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:deploy": {
			"cache": false
		},
		"db:studio": {
			"cache": false
		},
		"db:scripts": {
			"cache": false,
			"interactive": true
		},
		"test:unit": {
			"cache": false
		}
	}
}
